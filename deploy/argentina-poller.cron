# Argentina (Nabsa) vessel line-up e-mail poller - every 30 min, Mon-Fri 6am-11:30pm (system time is America/Chicago).
# Install: sudo cp deploy/argentina-poller.cron /etc/cron.d/argentina-poller
*/30 6-23 * * 1-5 root /opt/vessel-lineup-dashboard/.venv/bin/python3 /opt/vessel-lineup-dashboard/argentina_poller.py >> /opt/vessel-lineup-dashboard/poller.log 2>&1
